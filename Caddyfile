www.{$SITE_DOMAIN} {
  redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
  encode zstd gzip
  reverse_proxy app:3000

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }

  request_body {
    max_size 12MB
  }

  log {
    output stdout
    format console
  }
}
