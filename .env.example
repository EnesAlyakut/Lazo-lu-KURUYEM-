# ============================================
# FK KURUYEMIŞ - ENVIRONMENT VARIABLES
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# Copy this file as .env and fill in the values

# ----- VERİTABANI / DATABASE (MySQL) -----
# Yerel geliştirme (Docker ile):
DATABASE_URL="mysql://fkuser:fkpassword@localhost:3306/fkkuruyemis"

# Ücretsiz bulut seçenekleri:
# Railway: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# PlanetScale: mysql://USER:PASSWORD@HOST/DATABASE?sslaccept=strict
# Aiven: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED

# ----- JWT AUTHENTICATION -----
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# ----- NEXTAUTH / NEXT.JS -----
NEXTAUTH_SECRET="your-nextauth-secret-change-this"
NEXTAUTH_URL="http://localhost:3000"

# ----- CLOUDİNARY (Görsel Depolama) -----
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# ----- İYZİCO ÖDEME -----
IYZICO_API_KEY="your-iyzico-api-key"
IYZICO_SECRET_KEY="your-iyzico-secret-key"
IYZICO_BASE_URL="https://api.iyzipay.com"

# ----- STRIPE (Opsiyonel) -----
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# ----- E-POSTA (Nodemailer) -----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="FK Kuruyemiş <noreply@fkkuruyemis.com>"

# ----- GENEL AYARLAR -----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="FK Kuruyemiş"
NEXT_PUBLIC_WHATSAPP_NUMBER="+905551234567"

# ----- KARGO AYARLARI -----
FREE_SHIPPING_THRESHOLD="250"
BASE_SHIPPING_COST="29.90"
