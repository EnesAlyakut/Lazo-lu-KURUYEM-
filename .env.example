# LAZOĞLU KURUYEMİŞ - örnek ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve örnek değerlerin tamamını değiştirin.

# Uygulama / alan adı
SITE_DOMAIN="example.com"
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_SITE_NAME="LAZOĞLU KURUYEMİŞ"
NEXT_PUBLIC_WHATSAPP_NUMBER="+905000000000"

# Docker MySQL
MYSQL_DATABASE="lazoglu"
MYSQL_USER="lazoglu"
MYSQL_PASSWORD="change-with-a-long-random-password"
MYSQL_ROOT_PASSWORD="change-with-another-long-random-password"
DATABASE_URL="mysql://lazoglu:change-with-a-long-random-password@localhost:3306/lazoglu"

# Yönetici oturumu
JWT_SECRET="change-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"
ADMIN_USERNAME="change-admin-username"
# Üretim: node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "your-password"
# Docker Compose için bcrypt değerini tek tırnak içinde tutun.
ADMIN_PASSWORD_HASH='$2a$12$replace-with-a-real-bcrypt-hash'

# PayTR
PAYTR_MERCHANT_ID="your-merchant-id"
PAYTR_MERCHANT_KEY="your-merchant-key"
PAYTR_MERCHANT_SALT="your-merchant-salt"
# Canlıya geçerken ikisini de 0 yapın.
PAYTR_TEST_MODE="1"
PAYTR_DEBUG_ON="1"

# E-posta
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="LAZOĞLU KURUYEMİŞ <noreply@example.com>"
CONTACT_EMAIL="info@example.com"

# Görsel yükleme (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# Kargo
FREE_SHIPPING_THRESHOLD="250"
BASE_SHIPPING_COST="29.90"

# Web push (opsiyonel)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:info@example.com"
